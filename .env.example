# =============================================================
# Auth Service — Environment Variables
# =============================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local or any file containing real secrets.
# =============================================================

# ------------------------------------------------------------------
# Backend API
# ------------------------------------------------------------------
# Base URL of the backend REST API consumed by all auth flows.
# Example: https://api.example.com
NEXT_PUBLIC_BACKEND_URL=

# ------------------------------------------------------------------
# API Authentication Keys
# These keys are sent as custom request headers (x-api-secret-key
# and x-api-public-key) on login and registration requests.
# ------------------------------------------------------------------
# Secret key — treat this like a password, rotate regularly.
NEXT_PUBLIC_SECRET_KEY=

# Public key — identifies this client application to the API.
NEXT_PUBLIC_PUBLIC_KEY=
